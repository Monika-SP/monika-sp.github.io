*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:#08080d;color:#f5f2f0;font-family:"DM Sans",system-ui,sans-serif;letter-spacing:.02em;overflow-x:hidden}a{color:inherit;text-decoration:none}button{font:inherit}.scroll-progress{position:fixed;z-index:100;top:0;left:0;width:0;height:3px;background:linear-gradient(90deg,#f0a6c7,#b9a5ff,#8be3d1);box-shadow:0 0 16px #e7a8ca}.nav{height:76px;position:fixed;z-index:50;top:0;left:0;right:0;display:flex;align-items:center;justify-content:space-between;padding:0 5vw;background:rgba(8,8,13,.72);backdrop-filter:blur(20px);border-bottom:1px solid rgba(255,255,255,.08)}.logo{display:flex;gap:11px;align-items:center;font-size:13px;font-weight:600;letter-spacing:.12em}.logo-mark{width:36px;height:36px;border:1px solid rgba(255,255,255,.22);border-radius:50%;display:grid;place-items:center;font-size:11px;color:#f2b5ce;box-shadow:0 0 22px rgba(236,166,202,.12)}.nav nav{display:flex;gap:5px}.nav nav a{font-size:12px;padding:8px 12px;border-radius:30px;color:#bcb9c0;transition:.3s}.nav nav a:hover{background:#f5f2f0;color:#101016;transform:translateY(-2px)}.resume-actions{display:flex;gap:9px;flex-wrap:wrap;align-items:center}.btn{display:inline-flex;align-items:center;justify-content:center;border-radius:100px;padding:11px 17px;font-size:12px;border:1px solid rgba(255,255,255,.18);transition:transform .25s,background .25s,box-shadow .25s}.btn-light{background:#f5f2f0;color:#0b0b10;border-color:#f5f2f0;box-shadow:0 8px 28px rgba(245,242,240,.12)}.btn-line{background:rgba(255,255,255,.03)}.btn:hover{transform:translateY(-3px);box-shadow:0 12px 30px rgba(226,158,195,.12)}.menu{display:none;background:none;color:#eee;border:0;font-size:20px}.hero{min-height:100vh;position:relative;display:flex;align-items:center;padding:150px 7vw 80px;overflow:hidden;background:#08080d}.hero-photo{position:absolute;inset:0;background-image:url("portfolio-hero-bg.png");background-size:cover;background-position:center right;z-index:0;transform:scale(1.01);}
.hero-photo-overlay{position:absolute;inset:0;background:linear-gradient(90deg,rgba(8,8,13,.97) 0%,rgba(8,8,13,.90) 24%,rgba(8,8,13,.58) 48%,rgba(8,8,13,.16) 73%,rgba(8,8,13,.10) 100%),linear-gradient(180deg,rgba(8,8,13,.30),rgba(8,8,13,.48));}
.hero-photo:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(224,160,194,.06),transparent 40%),radial-gradient(circle at 78% 45%,rgba(255,255,255,.06),transparent 30%);mix-blend-mode:screen;}
.grid-bg{position:absolute;inset:0;opacity:.17;background-image:linear-gradient(rgba(255,255,255,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.05) 1px,transparent 1px);background-size:70px 70px;mask-image:linear-gradient(to bottom,#000,transparent 85%)}.aurora{position:absolute;border-radius:50%;filter:blur(60px);opacity:.18;animation:drift 10s ease-in-out infinite}.a1{width:260px;height:260px;background:#d88db4;right:12%;top:8%}.a2{width:230px;height:230px;background:#9e91f7;left:6%;bottom:5%;animation-delay:-4s}.hero-content{position:relative;z-index:6;max-width:700px}.availability{font-size:10px;color:#aaa;display:flex;align-items:center;gap:9px;margin-bottom:30px}.availability i{width:7px;height:7px;background:#8be3d1;border-radius:50%;box-shadow:0 0 16px #8be3d1;animation:pulse 1.7s infinite}.kicker,.section-head>span,.contact-content>span{font-size:11px;color:#918c98;letter-spacing:.18em}.hero h1{font-size:clamp(48px,8vw,100px);line-height:.95;font-weight:500;letter-spacing:-.055em;margin:12px 0 28px;font-family:"DM Sans",sans-serif}.outline{-webkit-text-stroke:1px #f5f2f0;color:transparent}.hero-description{color:#aaa6af;max-width:580px;line-height:1.8;font-size:15px}.hero-actions{display:flex;gap:9px;margin:30px 0 24px;flex-wrap:wrap}.quick-links{display:flex;gap:20px;color:#77727f;font-size:11px}.quick-links a:hover{color:#f5f2f0}.workspace{position:absolute;right:0;bottom:0;width:50%;height:72%;z-index:2;opacity:0;pointer-events:none}.desk{position:absolute;bottom:12%;left:2%;right:0;height:10px;background:#2a2931;transform:skewX(-12deg);box-shadow:0 0 50px rgba(224,155,195,.08)}.monitor{position:absolute;right:15%;bottom:22%;width:53%;height:48%}.screen{height:76%;border:7px solid #202027;border-radius:10px;background:#0c0c12;box-shadow:0 25px 70px #000;overflow:hidden}.terminal-top{height:24px;background:#191920;display:flex;gap:5px;padding:8px}.terminal-top span{width:5px;height:5px;background:#696673;border-radius:50%}.terminal-lines{font:12px/2.1 monospace;color:#777;padding:25px}.terminal-lines b{color:#c2bcc8}.terminal-lines em{color:#f1accb;font-style:normal}.monitor-neck{width:12%;height:18%;background:#23232b;margin:auto}.monitor-base{width:42%;height:5%;background:#292932;margin:auto;border-radius:10px}.person{position:absolute;right:3%;bottom:13%;width:25%;height:58%}.head{position:absolute;left:34%;top:4%;width:27%;height:21%;border-radius:50%;background:#b77855}.hair{position:absolute;left:29%;top:0;width:38%;height:18%;background:#17171c;border-radius:55% 55% 30% 30%}.body{position:absolute;left:22%;top:22%;width:50%;height:54%;background:#393740;border-radius:25px 25px 8px 8px}.arm{position:absolute;background:#b77855;height:13%;width:50%;top:39%;border-radius:30px}.arm-left{left:4%;transform:rotate(25deg)}.arm-right{right:0;transform:rotate(55deg)}.coffee{position:absolute;right:25%;bottom:16%;width:35px;height:30px;border:5px solid #35343d;border-radius:4px}.plant{position:absolute;left:5%;bottom:14%;width:60px;height:90px}.plant div{position:absolute;bottom:0;left:20px;width:25px;height:35px;background:#292931;border-radius:3px}.plant span{position:absolute;bottom:28px;left:26px;width:10px;height:48px;background:#3a3944;border-radius:100% 0}.plant span:nth-child(2){transform:rotate(55deg);left:15px}.plant span:nth-child(3){transform:rotate(-50deg);left:36px}.floating-code{position:absolute;color:#8e8994;font:11px monospace;border:1px solid rgba(255,255,255,.1);background:rgba(13,13,20,.55);padding:8px 12px;border-radius:12px;backdrop-filter:blur(8px);animation:float 5s ease-in-out infinite;box-shadow:0 12px 35px rgba(0,0,0,.18)}.c1{top:7%;left:10%}.c2{top:22%;right:4%;animation-delay:1s}.c3{bottom:45%;left:4%;animation-delay:2s}.cute-star{position:absolute;color:#e9a8c7;font-size:22px;animation:float 4s ease-in-out infinite}.s1{top:17%;left:25%}.s2{right:10%;bottom:45%;animation-delay:1.5s}.scroll{position:absolute;bottom:30px;left:7vw;font-size:9px;color:#66616c}.scroll span{margin-left:8px;color:#eee}.section{max-width:1200px;margin:auto;padding:130px 5vw;border-top:1px solid rgba(255,255,255,.07)}.section-head{display:grid;grid-template-columns:140px 1fr;gap:30px;margin-bottom:70px}.section-head h2{font-size:clamp(34px,5vw,65px);font-weight:500;line-height:1.05;margin:0;letter-spacing:-.045em}.section-head em{font-family:"Playfair Display",serif;font-style:italic;color:#dba3c1}.about-grid{display:grid;grid-template-columns:140px 1fr}.about-number{color:#393640;font-size:80px}.about-copy{max-width:750px}.about-copy p{color:#85808c;line-height:1.9;font-size:14px;margin:0 0 22px}.about-copy .big{color:#ddd9df;font-size:22px;line-height:1.55}.skills-section{padding:120px 0;border-top:1px solid rgba(255,255,255,.07)}.skills-section .section-head,.skill-cards{max-width:1200px;margin-left:auto;margin-right:auto;padding-left:5vw;padding-right:5vw}.skills-marquee{overflow:hidden;border-top:1px solid rgba(255,255,255,.07);border-bottom:1px solid rgba(255,255,255,.07);margin-bottom:50px}.marquee-track{display:flex;width:max-content;animation:marquee 22s linear infinite}.marquee-track span{font-size:clamp(45px,7vw,90px);color:#26242d;padding:15px 25px;white-space:nowrap}.marquee-track span:nth-child(even){color:#504953}.skill-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;background:transparent}.skill-card{min-height:250px;background:linear-gradient(145deg,rgba(255,255,255,.07),rgba(255,255,255,.018));padding:25px;border:1px solid rgba(255,255,255,.08);border-radius:24px;position:relative;overflow:hidden;transition:.4s;box-shadow:0 15px 50px rgba(0,0,0,.12);animation:skillFloat 5.5s ease-in-out infinite;}
.skill-card:nth-child(2){animation-delay:-1.1s}.skill-card:nth-child(3){animation-delay:-2.2s}.skill-card:nth-child(4){animation-delay:-3.3s}.skill-card:nth-child(5){animation-delay:-4.4s}.skill-card:nth-child(6){animation-delay:-5.5s}
.skill-card:nth-child(2n){transform:translateY(10px) rotate(.35deg)}.skill-card:nth-child(3n){transform:translateY(-7px) rotate(-.35deg)}
.skill-card:hover{animation-play-state:paused}
.skill-icon{animation:iconBop 3.2s ease-in-out infinite}
.skill-card:nth-child(2n) .skill-icon{animation-delay:.7s}
.skill-card:nth-child(3n) .skill-icon{animation-delay:1.4s}
.skill-card:before{content:"";position:absolute;width:120px;height:120px;right:-50px;bottom:-50px;background:rgba(220,158,196,.12);border-radius:50%;filter:blur(2px)}.skill-card:hover{transform:translateY(-9px) rotate(-.4deg);border-color:rgba(237,167,201,.35);box-shadow:0 20px 60px rgba(205,141,178,.1)}.skill-icon{width:68px;height:68px;border:1px solid rgba(255,255,255,.1);border-radius:20px;display:grid;place-items:center;position:relative;margin-bottom:52px;background:rgba(255,255,255,.035);transition:.45s;overflow:hidden}.skill-icon img{width:35px;height:35px;filter:drop-shadow(0 6px 12px rgba(255,255,255,.15))}.skill-icon b{display:none;font-size:14px}.skill-card:hover .skill-icon{transform:translateY(-5px) rotate(7deg) scale(1.08);background:rgba(237,168,201,.08)}.skill-card h3{font-size:20px;font-weight:500;margin:0 0 8px}.skill-card p{font-size:11px;color:#76717d}.skill-card>span{position:absolute;right:20px;top:20px;color:#5d5764;font-size:11px}.spark{position:absolute;right:23px;bottom:22px;color:#e7a8c9;font-style:normal;animation:sparkle 2.4s ease-in-out infinite}.skill-card:nth-child(2n) .spark{animation-delay:1s}.project-section{max-width:1300px}.project-card{display:grid;grid-template-columns:1.15fr .85fr;min-height:650px;background:#0b0b11;border:1px solid rgba(255,255,255,.1);border-radius:30px;overflow:hidden;box-shadow:0 35px 100px rgba(0,0,0,.25)}.project-video{position:relative;min-height:650px;overflow:hidden;background:#111}.project-video video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:saturate(.88) contrast(.98);transform:scale(1.02);transition:transform 1.2s ease,filter 1s ease}.project-card:hover .project-video video{transform:scale(1.06);filter:saturate(1.04) contrast(1.02)}.video-shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(10,10,15,.22),rgba(10,10,15,.12) 40%,rgba(10,10,15,.82)),linear-gradient(90deg,rgba(8,8,13,.08),rgba(8,8,13,.42))}.video-top,.video-bottom{position:absolute;left:22px;right:22px;display:flex;align-items:center;justify-content:space-between;gap:10px;z-index:2;font-size:9px;letter-spacing:.14em;color:#fff}.video-top{top:22px}.video-bottom{bottom:22px;justify-content:flex-start;flex-wrap:wrap}.video-bottom span{padding:7px 10px;border:1px solid rgba(255,255,255,.25);border-radius:30px;background:rgba(0,0,0,.22);backdrop-filter:blur(8px)}.live-dot{display:flex;gap:7px;align-items:center}.live-dot i{width:7px;height:7px;border-radius:50%;background:#8be3d1;box-shadow:0 0 12px #8be3d1;animation:pulse 1.5s infinite}.video-center{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);z-index:2;text-align:center}.video-center span{display:grid;place-items:center;width:74px;height:74px;border-radius:50%;background:rgba(255,255,255,.88);color:#17131a;margin:auto;font-size:19px;padding-left:3px;box-shadow:0 15px 45px rgba(0,0,0,.25);animation:breathe 2.5s ease-in-out infinite}.video-center small{display:block;margin-top:13px;font-size:8px;letter-spacing:.2em;color:#fff}.floating-heart{position:absolute;z-index:2;color:#f4b1ce;font-size:24px;text-shadow:0 0 20px rgba(242,172,202,.45);animation:heartFloat 4.5s ease-in-out infinite}.h1{right:15%;top:22%}.h2{left:15%;top:38%;font-size:18px;animation-delay:1.1s}.h3{right:28%;bottom:28%;font-size:16px;animation-delay:2s}.project-info{padding:45px;display:flex;flex-direction:column;justify-content:center;background:linear-gradient(145deg,#101018,#0b0b10)}.project-meta{display:flex;justify-content:space-between;color:#6e6976;font-size:9px}.project-info h3{font-family:"Playfair Display",serif;font-size:56px;font-weight:500;letter-spacing:-.04em;margin:55px 0 3px}.project-sub{color:#e0a6c3;font-size:13px}.project-info>p:not(.project-sub){color:#85808b;font-size:13px;line-height:1.8}.project-info ul{padding:15px 0 10px 18px;color:#85808b;font-size:11px;line-height:2}.tech-tags{display:flex;gap:6px;flex-wrap:wrap}.tech-tags span{border:1px solid rgba(255,255,255,.12);border-radius:30px;padding:6px 10px;font-size:9px;color:#aaa4b0}.experience-row,.edu-card{display:grid;grid-template-columns:1fr 1.3fr 60px;gap:50px;border-top:1px solid rgba(255,255,255,.1);padding:35px 0}.experience-row h3,.edu-card h3{font-size:25px;font-weight:500;margin:15px 0 4px}.date{font-size:9px;color:#66616d}.experience-row p,.edu-card p{font-size:12px;color:#77727e;line-height:1.8}.exp-number{color:#3b3742}.education .edu-card{grid-template-columns:1fr 1fr}.edu-card strong{font-size:14px;color:#eee}.contact{min-height:90vh;position:relative;overflow:hidden;border-top:1px solid rgba(255,255,255,.07);display:grid;place-items:center;text-align:center;background:radial-gradient(circle at 50% 50%,rgba(224,160,194,.08),transparent 45%)}.contact-content{position:relative;z-index:3;padding:100px 20px}.contact-content h2{font-size:clamp(55px,9vw,120px);font-weight:500;line-height:.9;letter-spacing:-.06em;margin:25px 0}.contact-content p{color:#77727e}.email-big{display:inline-block;font-size:clamp(15px,2vw,24px);margin:30px 0;border-bottom:1px solid #625c67;padding-bottom:8px}.contact-grid{display:flex;justify-content:center;gap:35px;margin:30px 0 40px;flex-wrap:wrap}.contact-grid a{font-size:12px;color:#aaa4af}.contact-grid small{display:block;color:#4e4955;font-size:8px;margin-bottom:8px}.contact-orbit{position:absolute;inset:-20%;animation:spin 28s linear infinite}.contact-orbit div{position:absolute;border:1px solid rgba(255,255,255,.05);border-radius:50%;inset:20%}.contact-orbit div:nth-child(2){inset:30%;transform:rotate(30deg)}.contact-orbit div:nth-child(3){inset:40%;transform:rotate(60deg)}footer{padding:25px 5vw;border-top:1px solid rgba(255,255,255,.07);display:flex;justify-content:space-between;color:#4e4955;font-size:9px}@keyframes skillFloat{0%,100%{translate:0 0}50%{translate:0 -9px}}@keyframes iconBop{0%,100%{transform:rotate(0) scale(1)}50%{transform:rotate(4deg) scale(1.06)}}@keyframes pulse{50%{opacity:.35;box-shadow:0 0 3px #8be3d1}}@keyframes float{50%{transform:translateY(-12px)}}@keyframes drift{0%,100%{transform:translate3d(0,0,0)}50%{transform:translate3d(25px,-20px,0)}}@keyframes marquee{to{transform:translateX(-50%)}}@keyframes spin{to{transform:rotate(360deg)}}@keyframes sparkle{50%{transform:scale(1.35) rotate(12deg);opacity:.45}}@keyframes heartFloat{0%,100%{transform:translateY(0) rotate(-6deg)}50%{transform:translateY(-16px) rotate(6deg)}}@keyframes breathe{50%{transform:scale(1.08);box-shadow:0 20px 60px rgba(244,180,207,.22)}}.reveal{opacity:0;transform:translateY(35px);transition:opacity .8s,transform .8s}.reveal.visible{opacity:1;transform:none}.cursor,.cursor-ring{position:fixed;pointer-events:none;z-index:100;display:none}.cursor{width:7px;height:7px;background:#eee;border-radius:50%}.cursor-ring{width:35px;height:35px;border:1px solid #8e8994;border-radius:50%;transition:.08s}.cursor-ring.hover{transform:scale(1.7);border-color:#f1b0cb}@media(min-width:1000px){body{cursor:none}.cursor,.cursor-ring{display:block}}@media(max-width:900px){.hero-photo{background-position:62% center}.hero-photo-overlay{background:linear-gradient(90deg,rgba(8,8,13,.96),rgba(8,8,13,.72) 48%,rgba(8,8,13,.35)),linear-gradient(180deg,rgba(8,8,13,.35),rgba(8,8,13,.55))}
.nav nav{display:none}.menu{display:block}.nav .resume-actions{display:none}.workspace{opacity:.35;width:75%}.hero{padding-top:130px}.section-head{grid-template-columns:1fr;gap:10px}.skill-cards{grid-template-columns:1fr 1fr}.project-card{grid-template-columns:1fr}.project-video{min-height:470px}.project-info{min-height:500px}.experience-row,.edu-card{grid-template-columns:1fr;gap:10px}.about-grid{grid-template-columns:1fr}.about-number{display:none}}@media(max-width:550px){.hero-photo{background-position:66% center}.hero-photo-overlay{background:linear-gradient(90deg,rgba(8,8,13,.97),rgba(8,8,13,.80) 55%,rgba(8,8,13,.50)),linear-gradient(180deg,rgba(8,8,13,.40),rgba(8,8,13,.65))}
.nav{padding:0 20px}.hero{padding-left:22px;padding-right:22px}.section{padding:90px 22px}.hero h1{font-size:53px}.workspace{width:100%;right:-35%;opacity:.18}.quick-links{gap:10px;flex-wrap:wrap}.skill-cards{grid-template-columns:1fr}.project-info{padding:28px}.project-info h3{font-size:43px;margin-top:40px}.project-video{min-height:390px}.video-top{left:15px;right:15px}.video-bottom{left:15px;right:15px}.video-center span{width:62px;height:62px}.resume-actions{justify-content:center}footer{flex-direction:column;gap:8px}}
